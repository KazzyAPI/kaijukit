{
  "id": "v1-group-member-remove",
  "ops": [
    "removeMemberFromGroupByGroupId"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "page1",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "page1 {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>alpha beta alpha</p>"
        }
      }
    },
    {
      "as": "grp",
      "method": "POST",
      "path": "/wiki/rest/api/group",
      "body": {
        "name": "grp{{run}}"
      }
    },
    {
      "method": "POST",
      "path": "/wiki/rest/api/group/userByGroupId?groupId={{grp.id}}",
      "body": {
        "accountId": "{{page1.authorId}}"
      },
      "as": "m"
    }
  ],
  "request": {
    "method": "DELETE",
    "path": "/wiki/rest/api/group/userByGroupId?groupId={{grp.id}}&accountId={{page1.authorId}}"
  },
  "expect": {
    "status": 204
  }
}
