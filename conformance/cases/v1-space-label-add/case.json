{
  "id": "v1-space-label-add",
  "ops": [
    "addLabelsToSpace"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "page1",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "page1 {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>alpha beta alpha</p>"
        }
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "/wiki/rest/api/space/{{space.key}}/label",
    "body": [
      {
        "name": "docs"
      }
    ]
  },
  "expect": {
    "status": 200
  }
}
