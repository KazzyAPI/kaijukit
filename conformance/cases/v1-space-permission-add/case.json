{
  "id": "v1-space-permission-add",
  "ops": [
    "addPermissionToSpace"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "grp",
      "method": "POST",
      "path": "/wiki/rest/api/group",
      "body": {
        "name": "grp{{run}}"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "/wiki/rest/api/space/{{space.key}}/permission",
    "body": {
      "subject": {
        "type": "group",
        "identifier": "{{grp.id}}"
      },
      "operation": {
        "key": "archive",
        "target": "page"
      }
    }
  },
  "expect": {
    "status": 200
  }
}
