{
  "id": "v2-blogpost-custom-content",
  "ops": [
    "getCustomContentByTypeInBlogPost"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "blog",
      "method": "POST",
      "path": "/wiki/api/v2/blogposts",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "Blog {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>hello</p>"
        }
      }
    },
    {
      "as": "cc",
      "method": "POST",
      "path": "/wiki/api/v2/custom-content",
      "body": {
        "type": "ac:conf:thing",
        "blogPostId": "{{blog.id}}",
        "title": "CC {{run}}",
        "body": {
          "representation": "raw",
          "value": "x"
        }
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/wiki/api/v2/blogposts/{{blog.id}}/custom-content",
    "query": {
      "type": "ac:conf:thing"
    }
  },
  "expect": {
    "status": 200
  }
}
