{
  "id": "v2-blogpost-property-update",
  "ops": [
    "updateBlogpostPropertyById"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "blog",
      "method": "POST",
      "path": "/wiki/api/v2/blogposts",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "Blog {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>hello</p>"
        }
      }
    },
    {
      "as": "pr",
      "method": "POST",
      "path": "/wiki/api/v2/blogposts/{{blog.id}}/properties",
      "body": {
        "key": "k",
        "value": {
          "a": 1
        }
      }
    }
  ],
  "request": {
    "method": "PUT",
    "path": "/wiki/api/v2/blogposts/{{blog.id}}/properties/{{pr.id}}",
    "body": {
      "key": "k",
      "value": {
        "a": 2
      },
      "version": {
        "number": 2
      }
    }
  },
  "expect": {
    "status": 200
  }
}
