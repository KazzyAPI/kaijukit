{
  "id": "v2-comment-property-update",
  "ops": [
    "updateCommentPropertyById"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "page1",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "page1 {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>alpha beta alpha</p>"
        }
      }
    },
    {
      "as": "footer",
      "method": "POST",
      "path": "/wiki/api/v2/footer-comments",
      "body": {
        "pageId": "{{page1.id}}",
        "body": {
          "representation": "storage",
          "value": "<p>first</p>"
        }
      }
    },
    {
      "as": "cprop",
      "method": "POST",
      "path": "/wiki/api/v2/comments/{{footer.id}}/properties",
      "body": {
        "key": "color",
        "value": {
          "a": 1
        }
      }
    }
  ],
  "request": {
    "method": "PUT",
    "path": "/wiki/api/v2/comments/{{footer.id}}/properties/{{cprop.id}}",
    "body": {
      "key": "color",
      "value": "b",
      "version": {
        "number": 2
      }
    }
  },
  "expect": {
    "status": 200
  }
}
