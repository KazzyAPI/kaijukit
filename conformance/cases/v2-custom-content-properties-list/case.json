{
  "id": "v2-custom-content-properties-list",
  "ops": [
    "getCustomContentContentProperties"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "cc",
      "method": "POST",
      "path": "/wiki/api/v2/custom-content",
      "body": {
        "type": "ac:conf:thing",
        "spaceId": "{{space.id}}",
        "title": "CC {{run}}",
        "body": {
          "representation": "raw",
          "value": "{\"a\":1}"
        }
      }
    },
    {
      "as": "pr",
      "method": "POST",
      "path": "/wiki/api/v2/custom-content/{{cc.id}}/properties",
      "body": {
        "key": "k",
        "value": {
          "a": 1
        }
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/wiki/api/v2/custom-content/{{cc.id}}/properties"
  },
  "expect": {
    "status": 200
  }
}
