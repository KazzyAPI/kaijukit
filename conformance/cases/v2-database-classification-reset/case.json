{
  "id": "v2-database-classification-reset",
  "ops": [
    "postDatabaseClassificationLevel"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "x",
      "method": "POST",
      "path": "/wiki/api/v2/databases",
      "body": {
        "spaceId": "{{space.id}}",
        "title": "x {{run}}"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "/wiki/api/v2/databases/{{x.id}}/classification-level/reset",
    "body": {
      "status": "current"
    }
  },
  "expect": {
    "status": 204
  }
}
