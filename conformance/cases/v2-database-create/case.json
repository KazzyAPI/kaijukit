{
  "id": "v2-database-create",
  "ops": [
    "createDatabase"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "/wiki/api/v2/databases",
    "body": {
      "spaceId": "{{space.id}}",
      "title": "D {{run}}"
    }
  },
  "expect": {
    "status": 200
  }
}
