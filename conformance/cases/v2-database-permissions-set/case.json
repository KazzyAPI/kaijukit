{
  "id": "v2-database-permissions-set",
  "ops": [
    "setDatabasePermissions"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "x",
      "method": "POST",
      "path": "/wiki/api/v2/databases",
      "body": {
        "spaceId": "{{space.id}}",
        "title": "x {{run}}"
      }
    }
  ],
  "request": {
    "method": "PUT",
    "path": "/wiki/api/v2/databases/{{x.id}}/permissions",
    "body": {
      "permissions": [
        {
          "operation": "update",
          "principals": [
            {
              "principalType": "user",
              "principalId": "{{space.authorId}}"
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "status": 200
  }
}
