{
  "id": "v2-database-property-get",
  "ops": [
    "getDatabaseContentPropertiesById"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "x",
      "method": "POST",
      "path": "/wiki/api/v2/databases",
      "body": {
        "spaceId": "{{space.id}}",
        "title": "D {{run}}"
      }
    },
    {
      "as": "pr",
      "method": "POST",
      "path": "/wiki/api/v2/databases/{{x.id}}/properties",
      "body": {
        "key": "k",
        "value": {
          "a": 1
        }
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/wiki/api/v2/databases/{{x.id}}/properties/{{pr.id}}"
  },
  "expect": {
    "status": 200
  }
}
