{
  "id": "v2-embed-property-delete",
  "ops": [
    "deleteSmartLinkPropertyById"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "x",
      "method": "POST",
      "path": "/wiki/api/v2/embeds",
      "body": {
        "spaceId": "{{space.id}}",
        "title": "E {{run}}",
        "embedUrl": "https://example.com/x"
      }
    },
    {
      "as": "pr",
      "method": "POST",
      "path": "/wiki/api/v2/embeds/{{x.id}}/properties",
      "body": {
        "key": "k",
        "value": {
          "a": 1
        }
      }
    }
  ],
  "request": {
    "method": "DELETE",
    "path": "/wiki/api/v2/embeds/{{x.id}}/properties/{{pr.id}}"
  },
  "expect": {
    "status": 204
  }
}
