{
  "id": "v2-folder-direct-children",
  "ops": [
    "getFolderDirectChildren"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "x",
      "method": "POST",
      "path": "/wiki/api/v2/folders",
      "body": {
        "spaceId": "{{space.id}}",
        "title": "F {{run}}"
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/wiki/api/v2/folders/{{x.id}}/direct-children"
  },
  "expect": {
    "status": 200
  }
}
