{
  "id": "v2-inline-comment-get",
  "ops": [
    "getInlineCommentById"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "page1",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "page1 {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>alpha beta alpha</p>"
        }
      }
    },
    {
      "as": "inline",
      "method": "POST",
      "path": "/wiki/api/v2/inline-comments",
      "body": {
        "pageId": "{{page1.id}}",
        "body": {
          "representation": "storage",
          "value": "<p>q</p>"
        },
        "inlineCommentProperties": {
          "textSelection": "alpha",
          "textSelectionMatchCount": 2,
          "textSelectionMatchIndex": 0
        }
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/wiki/api/v2/inline-comments/{{inline.id}}",
    "query": {
      "body-format": "storage",
      "include-versions": "true"
    }
  },
  "expect": {
    "status": 200
  }
}
