{
  "id": "v2-page-classification-get",
  "ops": [
    "getPageClassificationLevel"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "x",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "title": "x {{run}}",
        "status": "current",
        "body": {
          "representation": "storage",
          "value": "<p>hello</p>"
        }
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/wiki/api/v2/pages/{{x.id}}/classification-level"
  },
  "expect": {
    "status": 200
  }
}
