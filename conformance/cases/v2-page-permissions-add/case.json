{
  "id": "v2-page-permissions-add",
  "ops": [
    "addPagePermissions"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "x",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "title": "x {{run}}",
        "status": "current",
        "body": {
          "representation": "storage",
          "value": "<p>hello</p>"
        }
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "/wiki/api/v2/pages/{{x.id}}/permissions",
    "body": {
      "permissions": [
        {
          "operation": "update",
          "principals": [
            {
              "principalType": "user",
              "principalId": "{{space.authorId}}"
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "status": 200
  }
}
