{
  "id": "v2-page-properties-list",
  "ops": [
    "getPageContentProperties"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "page1",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "page1 {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>alpha beta alpha</p>"
        }
      }
    },
    {
      "as": "prop",
      "method": "POST",
      "path": "/wiki/api/v2/pages/{{page1.id}}/properties",
      "body": {
        "key": "color",
        "value": {
          "a": 1
        }
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/wiki/api/v2/pages/{{page1.id}}/properties",
    "query": {
      "sort": "key"
    }
  },
  "expect": {
    "status": 200
  }
}
