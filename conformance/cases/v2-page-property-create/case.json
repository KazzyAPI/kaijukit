{
  "id": "v2-page-property-create",
  "ops": [
    "createPageProperty"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "page1",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "page1 {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>alpha beta alpha</p>"
        }
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "/wiki/api/v2/pages/{{page1.id}}/properties",
    "body": {
      "key": "color",
      "value": {
        "a": 1
      }
    }
  },
  "expect": {
    "status": 200
  }
}
