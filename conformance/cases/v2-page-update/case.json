{
  "id": "v2-page-update",
  "ops": [
    "updatePage"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "page1",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "page1 {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>hello</p>"
        }
      }
    }
  ],
  "request": {
    "method": "PUT",
    "path": "/wiki/api/v2/pages/{{page1.id}}",
    "body": {
      "id": "{{page1.id}}",
      "status": "current",
      "title": "page1 {{run}}",
      "body": {
        "representation": "storage",
        "value": "<p>edited</p>"
      },
      "version": {
        "number": 2
      }
    }
  },
  "expect": {
    "status": 200
  }
}
