{
  "id": "v2-pages-list",
  "ops": [
    "getPages"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "page1",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "page1 {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>hello</p>"
        }
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/wiki/api/v2/pages",
    "query": {
      "space-id": "{{space.id}}",
      "limit": "10"
    }
  },
  "expect": {
    "status": 200
  }
}
