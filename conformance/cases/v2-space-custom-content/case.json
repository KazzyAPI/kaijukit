{
  "id": "v2-space-custom-content",
  "ops": [
    "getCustomContentByTypeInSpace"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "cc",
      "method": "POST",
      "path": "/wiki/api/v2/custom-content",
      "body": {
        "type": "ac:conf:thing",
        "spaceId": "{{space.id}}",
        "title": "CC {{run}}",
        "body": {
          "representation": "raw",
          "value": "{\"a\":1}"
        }
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/wiki/api/v2/spaces/{{space.id}}/custom-content",
    "query": {
      "type": "ac:conf:thing"
    }
  },
  "expect": {
    "status": 200
  }
}
