{
  "id": "v2-space-property-create",
  "ops": [
    "createSpaceProperty"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    },
    {
      "as": "page1",
      "method": "POST",
      "path": "/wiki/api/v2/pages",
      "body": {
        "spaceId": "{{space.id}}",
        "status": "current",
        "title": "page1 {{run}}",
        "body": {
          "representation": "storage",
          "value": "<p>alpha beta alpha</p>"
        }
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "/wiki/api/v2/spaces/{{space.id}}/properties",
    "body": {
      "key": "theme",
      "value": {
        "d": 1
      }
    }
  },
  "expect": {
    "status": 201
  }
}
