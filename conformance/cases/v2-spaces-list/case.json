{
  "id": "v2-spaces-list",
  "ops": [
    "getSpaces"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/wiki/api/v2/spaces",
    "query": {
      "limit": "2"
    }
  },
  "expect": {
    "status": 200
  }
}
