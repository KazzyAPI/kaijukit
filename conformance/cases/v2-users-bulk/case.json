{
  "id": "v2-users-bulk",
  "ops": [
    "createBulkUserLookup"
  ],
  "setup": [
    {
      "as": "space",
      "method": "POST",
      "path": "/wiki/api/v2/spaces",
      "body": {
        "name": "Conf {{run}}",
        "key": "K{{run}}"
      }
    }
  ],
  "request": {
    "method": "POST",
    "path": "/wiki/api/v2/users-bulk",
    "body": {
      "accountIds": [
        "{{space.authorId}}"
      ]
    }
  },
  "expect": {
    "status": 200
  }
}
